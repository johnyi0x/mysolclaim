# ============================================================
# MySolClaim environment variables
# ============================================================

# Fee wallet PUBLIC address only (safe to publish — it only receives fees).
NEXT_PUBLIC_FEE_WALLET=

# Fee % of reclaimed rent (default 10). Clamped 0–50 in code.
NEXT_PUBLIC_FEE_PERCENT=10

# OPTIONAL but recommended for production reliability.
# Server-only — NEVER use the NEXT_PUBLIC_ prefix for this.
# Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# If unset, the site falls back to Solana's free public RPC
# (api.mainnet-beta.solana.com). That is why scanning can work
# without Helius — but public RPC is slow/rate-limited and will
# break under real traffic. Helius (or any private RPC) is strongly
# recommended once you have users.
HELIUS_RPC_URL=

# DO NOT create NEXT_PUBLIC_RPC_URL with your API key.
# Anything NEXT_PUBLIC_* is embedded in the browser and visible to everyone.
