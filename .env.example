# ============================================================
# MySolClaim environment variables
# ============================================================

# Fee wallet PUBLIC address only (safe to publish — it only receives fees).
# IMPORTANT: fund it once with ≥ ~0.001 SOL so the account exists on-chain.
# If it does not exist, the first tip must be ≥ rent-exempt (~0.00089088 SOL)
# or Solana rejects the transfer with InsufficientFundsForRent.
NEXT_PUBLIC_FEE_WALLET=

# Fee % of reclaimed rent (default 10). Clamped 0–50 in code.
NEXT_PUBLIC_FEE_PERCENT=10

# OPTIONAL backup RPC (server-only). Format:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Order of use:
#   1) Solana public RPC (api.mainnet-beta.solana.com) — tried first
#   2) HELIUS_RPC_URL — used only if public fails / rate-limits
#
# ~230 claims/day is usually fine on public alone; set Helius as insurance.
# NEVER put this key in a NEXT_PUBLIC_* variable.
HELIUS_RPC_URL=
