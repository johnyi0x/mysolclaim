# ============================================================
# MySolClaim environment variables
# Copy to .env.local for local development.
# Add the same vars in Vercel → Project → Settings → Env Vars.
# ============================================================

# Fresh fee wallet PUBLIC address only (never put the private key here).
NEXT_PUBLIC_FEE_WALLET=

# Fee percentage of reclaimed rent (10 = 10%). Clamped to 0–50 in code.
NEXT_PUBLIC_FEE_PERCENT=10

# Browser RPC. Helius does NOT show a full URL — build it from your API key:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_LONG_KEY_HERE
# Click the eye icon on the API Keys page to reveal/copy the key.
NEXT_PUBLIC_RPC_URL=

# Server-only RPC for /api/recent-claims (can be the same URL as above).
HELIUS_RPC_URL=
