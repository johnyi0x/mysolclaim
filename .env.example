# ============================================================
# MySolClaim environment variables
# Copy to .env.local for local development.
# Add the same vars in Vercel → Project → Settings → Env Vars.
# ============================================================

# Fresh fee wallet PUBLIC address only (never put the private key here).
# This is safe to be public — it only receives fees.
NEXT_PUBLIC_FEE_WALLET=

# Fee percentage of reclaimed rent (10 = 10%). Clamped to 0–50 in code.
NEXT_PUBLIC_FEE_PERCENT=10

# SERVER-ONLY Helius RPC URL (never use NEXT_PUBLIC_ for this).
# Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Used by /api/scan, /api/recent-claims, and /api/rpc (browser proxy).
# The key never ships to the browser bundle.
HELIUS_RPC_URL=

# DO NOT set NEXT_PUBLIC_RPC_URL with your Helius key.
# Anything NEXT_PUBLIC_* is visible to every visitor.
