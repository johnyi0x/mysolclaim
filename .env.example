# ============================================================
# MySolClaim environment variables
# ============================================================

# Fee wallet PUBLIC address (receive-only — safe as a normal Config var).
# No NEXT_PUBLIC_ prefix. Browser loads it from GET /api/fee-config.
# Fund once with ≥ ~0.001 SOL so the account exists on-chain.
FEE_WALLET=3h9pzHY4NitMBHWV8Djgm8bobmYWLYRk1oYUKPqf5fHF

# Fee % of reclaimed rent (default 5). Clamped 0–50 in code.
FEE_PERCENT=5

# Percent of the *service fee* paid to the referrer (default 30 → 70/30 split).
REFERRAL_SHARE_PERCENT=30

# Neon Postgres (server-only) — durable all-time + 24h claim stats.
# Create a project at https://neon.tech and paste the connection string.
# REQUIRED for accurate public stats that don't drop when RPC history rolls off.
# NEVER put this in a NEXT_PUBLIC_* variable. Never commit the real value.
NEON_CONNECTION_STRING=

# OPTIONAL durable claimant→referrer binding (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL backup RPC (server-only). Format:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# Order of use:
#   1) Solana public RPC (api.mainnet-beta.solana.com) — tried first
#   2) HELIUS_RPC_URL — used only if public fails / rate-limits
HELIUS_RPC_URL=
